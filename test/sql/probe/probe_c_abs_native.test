# name: test/sql/probe/probe_c_abs_native.test
# PROBE (#28): absolute path with native (backslash on Windows) separators,
# built by constant-folded replace(). On POSIX this produces a nonsense path
# with backslashes, so expect 0/error there; the Windows result is the signal.
# DELETE BEFORE MERGE.
require duck_tails

statement ok
LOAD duck_tails;

query I
SELECT 'abs_native:count=' || count(*)::VARCHAR FROM git_log(replace('__WORKING_DIRECTORY__/test/tmp/main-repo', '/', '\'));
----
PROBE_SENTINEL_NEVER_MATCHES
