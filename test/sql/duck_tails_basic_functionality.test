# name: test/sql/duck_tails_basic_functionality.test
# description: Basic functionality tests for Duck Tails git operations
# group: [sql]

require duck_tails

# Use __BUILD_DIRECTORY__ to ensure we load the freshly built extension
statement ok
SET extension_directory='__BUILD_DIRECTORY__/extension';

# Test diff_text function works
query I
SELECT length(diff_text('Hello World', 'Hello DuckDB')) > 0 as has_diff;
----
true

# Test diff_text with identical strings returns NULL
query I
SELECT diff_text('same', 'same') IS NULL as is_null;
----
true

# Test diff_text with different content
query I
SELECT diff_text('content', '') IS NOT NULL as has_diff;
----
true

# Test read_git_diff single argument works. The file has to exist: the
# single-argument form compares it against its HEAD version, and a file that
# cannot be read now raises instead of returning the error as a row (#55.2).
query I
SELECT COUNT(*) > 0 as has_rows FROM read_git_diff('README.md');
----
true

# Test read_git_diff two arguments works
query I
SELECT COUNT(*) > 0 as has_rows FROM read_git_diff('README.md', 'LICENSE');
----
true

# Test read_git_diff with git:// paths works
query I
SELECT COUNT(*) > 0 as has_rows FROM read_git_diff('git://README.md@HEAD', 'git://README.md@HEAD~1');
----
true

# Test text_diff_lines function works. 'dummy' carries no diff prefix, so it is
# a line outside any hunk and yields nothing; a real diff yields its lines
# (#54 -- this used to answer with three fixed rows for any input at all).
query I
SELECT COUNT(*) > 0 as has_rows FROM text_diff_lines(' context' || chr(10) || '-gone' || chr(10) || '+new');
----
true